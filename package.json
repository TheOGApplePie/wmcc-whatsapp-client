{
  "name": "wmcc-whatapp-client",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "tsc": "./bin/tsc.js"
  },
  "description": "A small client that implements whatsappwebjs to automate sending messages from the wmcc cms to whatsapp announcements",
  "main": "index.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "postinstall": "patch-package",
    "predeploy": "npm test && npm run build"
  },
  "author": "Danial Ali",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/qrcode-terminal": "^0.12.2",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}